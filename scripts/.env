# Fabric Ontology Lab Configuration
# Copy this file to .env and fill in your values
#
# NOTE: If you used 'azd up' to deploy, Azure service endpoints are loaded
# automatically from .azure/<env>/.env - no need to configure them here!
#
# If infrastructure is ALREADY PROVISIONED (no .azure folder):
#   Run: python scripts/generate_env_from_azure.py -g <resource-group-name>
#   This will auto-populate Azure endpoints from your existing resources.

# --- Default Set Deploy App to true ---
AZURE_ENV_DEPLOY_APP=true
USE_DATA_AGENT=true

# --- Microsoft Fabric (required) ---
FABRIC_WORKSPACE_ID='19492328-8416-4fbf-bd4b-491c936d0221'

# Solution name prefix (optional - defaults to AZURE_ENV_NAME from azd)
# SOLUTION_NAME=myproject

# --- Data Folder (pre-populated with default scenario) ---
DATA_FOLDER=data\20260922_113709_telecommunications

# --- AI Data Generation (for customization - Step 2) ---
INDUSTRY=Telecommunications
USECASE=Network operations with outage tracking and trouble ticket management
DATA_SIZE=small

# --- Agent IDs (auto-populated by scripts) ---
FABRIC_AGENT_ID=
FOUNDRY_AGENT_ID=

# =============================================================================
# AZURE SERVICES - Only needed if NOT using 'azd up'
# If you ran 'azd up', these are loaded from .azure/<env>/.env automatically
# =============================================================================

# --- Azure AI Foundry (from azd or manual) ---
# AZURE_AI_AGENT_ENDPOINT=https://your-ai-service.services.ai.azure.com/api/projects/your-project
# AZURE_AI_ENDPOINT=https://your-ai-service.services.ai.azure.com
# AZURE_CHAT_MODEL=gpt-5.4-mini
# AZURE_EMBEDDING_MODEL=text-embedding-3-large

# --- Azure AI Search (from azd or manual) ---
# AZURE_AI_SEARCH_ENDPOINT=https://your-search-service.search.windows.net

# --- Added from Azure ---
AZURE_SUBSCRIPTION_ID=e187510c-aecf-459d-ae1f-91fa4483ca40
SOLUTION_NAME=rd
RESOURCE_GROUP_NAME=rd-aafudfsa-prod-east-us
AZURE_OPENAI_ENDPOINT=https://aisa-rddapprod2o7j2.cognitiveservices.azure.com/
AZURE_ENV_GPT_MODEL_NAME=gpt-5.4-mini
AZURE_CHAT_MODEL=gpt-5.4-mini
AZURE_ENV_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_EMBEDDING_MODEL=text-embedding-3-small
AZURE_AI_AGENT_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_AI_SEARCH_ENDPOINT=https://srch-rddapprod2o7j2.search.windows.net
